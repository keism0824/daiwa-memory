{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "大和に灯る物語",
		"description": "兵庫県川西市大和地区の記憶のアーカイブ"
	},
	"settings": {
		"title": "大和に灯る物語",
		"tagline": "この地域と歩む、ひとりひとりの物語"
	},
	"collections": [
		{
			"slug": "posts",
			"label": "記録",
			"labelSingular": "記録",
			"urlPattern": "/posts/{slug}",
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"commentsEnabled": true,
			"fields": [
				{
					"slug": "title",
					"label": "タイトル",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "record_number",
					"label": "記録番号",
					"type": "string",
					"validation": {
						"pattern": "^0*[1-9][0-9]*$"
					}
				},
				{
					"slug": "featured_image",
					"label": "アイキャッチ写真",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "本文",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "リード",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "固定ページ",
			"labelSingular": "固定ページ",
			"urlPattern": "/pages/{slug}",
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"fields": [
				{
					"slug": "title",
					"label": "タイトル",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "本文",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "category",
			"label": "分類",
			"labelSingular": "分類",
			"hierarchical": true,
			"collections": ["posts"],
			"terms": [
				{
					"slug": "development",
					"label": "街の成り立ち"
				},
				{
					"slug": "daily-life",
					"label": "暮らしの記憶"
				},
				{
					"slug": "community",
					"label": "地域の活動"
				}
			]
		},
		{
			"name": "tag",
			"label": "タグ",
			"labelSingular": "タグ",
			"hierarchical": false,
			"collections": ["posts"]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "メインナビゲーション",
			"items": [
				{
					"type": "custom",
					"label": "トップ",
					"url": "/"
				},
				{
					"type": "custom",
					"label": "記録一覧",
					"url": "/posts"
				},
				{
					"type": "custom",
					"label": "この記録集について",
					"url": "/pages/about"
				}
			]
		}
	],
	"widgetAreas": [
		{
			"name": "sidebar",
			"label": "記事のサイドバー",
			"description": "記事ページに表示する案内",
			"widgets": [
				{
					"type": "component",
					"componentId": "core:search",
					"title": "記録を検索"
				},
				{
					"type": "component",
					"componentId": "core:categories",
					"title": "分類"
				},
				{
					"type": "component",
					"componentId": "core:tags",
					"title": "タグ"
				},
				{
					"type": "component",
					"componentId": "core:recent-posts",
					"title": "最新の記録",
					"props": {
						"count": 5,
						"showDate": true
					}
				},
				{
					"type": "component",
					"componentId": "core:archives",
					"title": "公開月から探す",
					"props": {
						"type": "monthly",
						"limit": 6
					}
				}
			]
		},
		{
			"name": "footer",
			"label": "フッター",
			"description": "サイトの下部に表示する案内",
			"widgets": [
				{
					"type": "content",
					"title": "記録する地域",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "兵庫県川西市大和地区（旧阪急北ネオポリス）",
									"_key": "text0"
								}
							],
							"_key": "paragraph0"
						}
					]
				}
			]
		}
	],
	"content": {
		"pages": [
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "この記録集について",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "大和に灯る物語は、兵庫県川西市大和地区（旧阪急北ネオポリス）の歴史と暮らしを、住民の語りと写真から記録するアーカイブです。",
									"_key": "text0"
								}
							],
							"_key": "paragraph0"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "街の開発当時を知る人、ここで暮らしを営んできた人、自治会や地域活動に関わってきた人。それぞれの記憶から、街の歩みをたどります。",
									"_key": "text1"
								}
							],
							"_key": "paragraph1"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "写真には、分かる範囲で撮影年代や場所、提供者を添えます。語り手の言葉と、その背景にある時間や場所を、次の世代がたどれる形で残していきます。",
									"_key": "text2"
								}
							],
							"_key": "paragraph2"
						}
					]
				}
			}
		],
		"posts": []
	}
}
