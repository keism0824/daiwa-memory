---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import Byline from "./Byline.astro";
import { formatDate } from "../utils/locale";
import { formatReadingTime, getReadingTime } from "../utils/reading-time";

interface Term {
	slug: string;
	label: string;
}

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	tags?: Term[];
	categories?: Term[];
	variant?: "card" | "contents" | "row";
	headingLevel?: 2 | 3;
	priority?: boolean;
}

const {
	post,
	tags = [],
	categories = [],
	variant = "card",
	headingLevel = 2,
	priority = false,
} = Astro.props;

const Heading = `h${headingLevel}` as const;
const href = `/posts/${post.id}`;
const title = post.data.title || "無題の記録";
const publishedAt = post.data.publishedAt ?? null;
const bylines = post.data.bylines ?? [];
const image = variant === "row" ? undefined : post.data.featured_image;
const visibleTags = tags.slice(0, variant === "card" ? 2 : 3);

const sizes = {
	card: "(min-width: 1080px) 360px, (min-width: 700px) 45vw, 90vw",
	contents: "(min-width: 600px) 10rem, 8.5rem",
};
---

<article class:list={["post", `post--${variant}`, { "post--with-image": image }]}>
	{(publishedAt || categories.length > 0 || variant === "card") && (
		<div class="post__meta">
			{publishedAt && (
				<time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, "short")}</time>
			)}
			{categories.length > 0 ? (
				<ul class="post__terms" aria-label="分類" role="list">
					{categories.map((term) => (
						<li><a href={`/category/${term.slug}`}>{term.label}</a></li>
					))}
				</ul>
			) : variant === "card" ? (
				<span>{formatReadingTime(getReadingTime(post.data.content))}</span>
			) : null}
		</div>
	)}
	<div class="post__body">
		<Heading class="post__title" {...post.edit.title}>
			<a href={href}>{title}</a>
		</Heading>
		{post.data.excerpt && (
			<p class="post__excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
		)}
		{(bylines.length > 0 || visibleTags.length > 0) && (
			<div class="post__footer">
				<Byline bylines={bylines} max={variant === "card" ? 1 : 2} size="xs" />
				{visibleTags.length > 0 && (
					<ul class="post__terms" aria-label="タグ" role="list">
						{visibleTags.map((tag) => (
							<li><a href={`/tag/${tag.slug}`}>{tag.label}</a></li>
						))}
					</ul>
				)}
			</div>
		)}
	</div>
	{variant !== "row" && image && (
		<div class="post__image" {...post.edit.featured_image}>
			<Image image={image} sizes={sizes[variant]} priority={priority} />
		</div>
	)}
</article>

<style>
	.post {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		gap: var(--spacing-3);
		min-width: 0;
	}

	.post__body {
		display: grid;
		gap: var(--spacing-3);
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.post__meta,
	.post__footer,
	.post__terms {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--spacing-1) var(--spacing-4);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.post__meta {
		font-variant-numeric: tabular-nums;
		overflow-wrap: anywhere;
	}

	.post__terms {
		list-style: none;
	}

	.post__terms a {
		color: var(--color-brand);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
	}

	.post__title {
		font-size: var(--font-size-xl);
		line-height: var(--leading-snug);
		line-break: strict;
	}

	.post__title a {
		color: inherit;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
	}

	.post__title a:hover,
	.post__title a:focus-visible {
		color: var(--color-brand);
		text-decoration-color: currentColor;
	}

	.post__excerpt {
		max-inline-size: 40rem;
		color: var(--color-text-secondary);
		font-size: var(--font-size-base);
		line-height: 1.75;
		line-break: strict;
	}

	.post__image :global(img) {
		display: block;
		max-inline-size: 100%;
		block-size: auto;
	}

	.post--card {
		padding-block-start: var(--spacing-4);
		border-block-start: 1px solid var(--color-border);
	}

	.post--row {
		row-gap: var(--spacing-2);
	}

	.post--row .post__body {
		gap: var(--spacing-2);
	}

	.post--row .post__excerpt,
	.post--contents .post__excerpt {
		max-inline-size: var(--paper-measure);
		font-family: var(--font-reading);
		font-size: 1.0625rem;
		line-height: 1.85;
	}

	.post--contents,
	.post--contents .post__body {
		gap: var(--spacing-2);
	}

	.post--contents .post__title {
		font-size: clamp(1.25rem, 1.1rem + 0.55vw, 1.5rem);
	}

	.post--contents .post__image {
		inline-size: min(100%, 8.5rem);
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.post--contents .post__image :global(img) {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	@media (min-width: 600px) {
		.post--contents.post--with-image {
			grid-template-columns: minmax(0, 1fr) 10rem;
			column-gap: clamp(1.25rem, 4vw, 3rem);
			align-content: start;
			grid-template-rows: auto 1fr;
		}

		.post--contents .post__image {
			grid-column: 2;
			grid-row: 1 / span 2;
			inline-size: 100%;
		}
	}

	@media (min-width: 720px) {
		.post--row {
			grid-template-columns: 8.5rem minmax(0, 1fr);
			column-gap: clamp(1.25rem, 4vw, 3rem);
		}

		.post--row .post__meta {
			flex-direction: column;
			align-items: start;
			padding-block-start: 0.35em;
		}

		.post--row .post__body {
			grid-column: 2;
		}
	}
</style>
