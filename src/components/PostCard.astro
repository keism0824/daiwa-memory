---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import Byline from "./Byline.astro";
import { formatDate } from "../utils/locale";
import { formatRecordNumber } from "../utils/record-number";
import { formatReadingTime, getReadingTime } from "../utils/reading-time";

interface Term {
	slug: string;
	label: string;
}

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	tags?: Term[];
	categories?: Term[];
	variant?: "card" | "contents";
	headingLevel?: 2 | 3;
	priority?: boolean;
}

const {
	post,
	tags = [],
	categories = [],
	variant = "card",
	headingLevel = 2,
	priority = false,
} = Astro.props;

const Heading = `h${headingLevel}` as const;
const href = `/posts/${post.id}`;
const title = post.data.title || "無題の記録";
const publishedAt = post.data.publishedAt ?? null;
const isContents = variant === "contents";
const bylines = isContents ? [] : post.data.bylines ?? [];
const recordNumber = isContents ? formatRecordNumber(post.data.record_number) : undefined;
const image = variant === "card" ? post.data.featured_image : undefined;
const visibleTags = tags.slice(0, variant === "card" ? 2 : 3);
---

<article class:list={["post", `post--${variant}`, { "post--with-record-number": recordNumber }]}>
	{recordNumber && (
		<p class="post__record-number">
			<span class="post__record-number-value">{recordNumber}</span>
		</p>
	)}
	{(publishedAt || variant === "card") && (
		<div class="post__meta">
			{publishedAt && (
				<time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, isContents ? "long" : "short")}</time>
			)}
			{!isContents && categories.length > 0 ? (
				<ul class="post__terms" aria-label="分類" role="list">
					{categories.map((term) => (
						<li><a href={`/category/${term.slug}`}>{term.label}</a></li>
					))}
				</ul>
			) : variant === "card" ? (
				<span>{formatReadingTime(getReadingTime(post.data.content))}</span>
			) : null}
		</div>
	)}
	<div class="post__body">
		{isContents ? (
			<a class="post__summary" href={href} aria-labelledby={`record-title-${post.data.id}`}>
				<Heading id={`record-title-${post.data.id}`} class="post__title" {...post.edit.title}>
					{title}
				</Heading>
				{post.data.excerpt && (
					<p class="post__excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
				)}
			</a>
		) : (
			<>
				<Heading class="post__title" {...post.edit.title}>
					<a href={href}>{title}</a>
				</Heading>
				{post.data.excerpt && (
					<p class="post__excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
				)}
			</>
		)}
		{isContents && categories.length > 0 && (
			<ul class="post__terms" aria-label="分類" role="list">
				{categories.map((term) => (
					<li><a href={`/category/${term.slug}`}>{term.label}</a></li>
				))}
			</ul>
		)}
		{(bylines.length > 0 || visibleTags.length > 0) && (
			<div class="post__footer">
				<Byline bylines={bylines} max={variant === "card" ? 1 : 2} size="xs" />
				{visibleTags.length > 0 && (
					<ul class="post__terms" aria-label="タグ" role="list">
						{visibleTags.map((tag) => (
							<li><a href={`/tag/${tag.slug}`}>{tag.label}</a></li>
						))}
					</ul>
				)}
			</div>
		)}
	</div>
	{image && (
		<div class="post__image" {...post.edit.featured_image}>
			<Image image={image} sizes="(min-width: 1080px) 360px, (min-width: 700px) 45vw, 90vw" priority={priority} />
		</div>
	)}
</article>

<style>
	.post {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		gap: var(--spacing-3);
		min-width: 0;
	}

	.post__body {
		display: grid;
		gap: var(--spacing-3);
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.post__meta,
	.post__footer,
	.post__terms {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--spacing-1) var(--spacing-4);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.post__meta {
		font-variant-numeric: tabular-nums;
		overflow-wrap: anywhere;
	}

	.post__terms {
		list-style: none;
	}

	.post__terms a {
		color: var(--color-brand);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
	}

	.post__title {
		font-size: var(--font-size-xl);
		line-height: var(--leading-snug);
		line-break: strict;
	}

	.post__title a {
		color: inherit;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
	}

	.post__title a:hover,
	.post__title a:focus-visible,
	.post__summary:hover .post__title,
	.post__summary:focus-visible .post__title {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.post__summary {
		display: grid;
		gap: var(--spacing-3);
		color: inherit;
		text-decoration: none;
	}

	.post__excerpt {
		max-inline-size: 40rem;
		color: var(--color-text-secondary);
		font-size: var(--font-size-base);
		line-height: 1.75;
		line-break: strict;
	}

	.post__image :global(img) {
		display: block;
		max-inline-size: 100%;
		block-size: auto;
	}

	.post--card {
		padding-block-start: var(--spacing-4);
		border-block-start: 1px solid var(--color-border);
	}

	.post--contents {
		row-gap: var(--spacing-2);
	}

	.post--with-record-number {
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		column-gap: clamp(0.5rem, 1.2vw, 0.875rem);
	}

	.post__record-number {
		grid-column: 1;
		grid-row: 1 / span 2;
		padding-inline-end: var(--spacing-2);
		border-inline-end: 1px solid var(--color-border);
		color: var(--color-muted);
		font-size: var(--font-size-label);
	}

	.post__record-number-value {
		display: block;
		writing-mode: vertical-rl;
		white-space: nowrap;
	}

	.post--contents .post__title {
		font-size: clamp(1.375rem, 1.175rem + 0.8vw, 1.75rem);
	}

	.post--contents .post__excerpt {
		max-inline-size: var(--paper-measure);
		font-family: var(--font-reading);
		font-size: 1.0625rem;
		line-height: 1.85;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
</style>
