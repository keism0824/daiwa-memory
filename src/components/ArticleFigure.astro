---
import type { InferCollectionData } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	image: NonNullable<InferCollectionData<"posts">["featured_image"]>;
}

const { image } = Astro.props;
---

<figure class="article-figure">
	<Image image={image} sizes="(max-width: 720px) 94vw, (min-width: 780px) 576px, 72vw" priority />
	{image.caption?.trim() && <figcaption>{image.caption}</figcaption>}
</figure>

<style>
	.article-figure {
		inline-size: fit-content;
		max-inline-size: min(80%, 36rem);
	}

	.article-figure :global(img) {
		display: block;
		max-inline-size: 100%;
		max-block-size: 33.6rem;
		inline-size: auto;
		block-size: auto;
	}

	figcaption {
		contain: inline-size;
		margin-block-start: var(--spacing-3);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.65;
		overflow-wrap: anywhere;
		white-space: pre-line;
	}

	@media (min-width: 780px) {
		.article-figure {
			max-inline-size: min(100%, 36rem);
		}
	}

	@media (max-width: 720px) {
		.article-figure,
		.article-figure :global(img) {
			inline-size: 100%;
			max-inline-size: 100%;
		}

		.article-figure :global(img) {
			max-block-size: none;
		}
	}
</style>
