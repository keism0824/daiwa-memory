---
import type { InferCollectionData } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	image: NonNullable<InferCollectionData<"posts">["featured_image"]>;
}

const { image } = Astro.props;
---

<figure class="article-figure">
	<Image image={image} sizes="(max-width: 720px) 94vw, 48rem" priority />
	{image.caption?.trim() && <figcaption>{image.caption}</figcaption>}
</figure>

<style>
	.article-figure {
		inline-size: fit-content;
		max-inline-size: 100%;
		margin-inline: auto;
	}

	.article-figure :global(img) {
		display: block;
		max-inline-size: 100%;
		inline-size: auto;
		block-size: auto;
		margin-inline: auto;
	}

	figcaption {
		contain: inline-size;
		margin-block-start: var(--spacing-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.65;
		overflow-wrap: anywhere;
		white-space: pre-line;
	}

</style>
