---
import type { ComponentProps } from "astro/types";
import { PTImage } from "emdash/ui";

type Props = ComponentProps<typeof PTImage>;

const { node, placeholder } = Astro.props;
const href = (typeof node?.link === "string" ? node.link : node?.link?.href)?.trim();
const source = href && /^https?:/i.test(href) && URL.canParse(href) ? new URL(href) : null;
---

{source ? (
	<div class="article-image-source" style={{ "--image-source-host": JSON.stringify(source.hostname) }}>
		<PTImage {node} {placeholder} />
	</div>
) : (
	<PTImage {node} {placeholder} />
)}

<style>
	.article-image-source {
		display: contents;
	}

	.article-image-source :global(.emdash-image > a[href^="http" i]) {
		position: relative;
		display: block;
		inline-size: fit-content;
		max-inline-size: 100%;
	}

	.article-image-source :global(.emdash-image > a img) {
		display: block;
	}

	.article-image-source :global(.emdash-image > a[href^="http" i])::after {
		content: var(--image-source-host) / "";
		position: absolute;
		inset-block-end: var(--spacing-2);
		inset-inline-start: var(--spacing-2);
		box-sizing: border-box;
		max-inline-size: calc(100% - 2 * var(--spacing-2));
		padding: var(--spacing-1) var(--spacing-2);
		overflow: hidden;
		border-radius: var(--radius-full);
		background: color-mix(in srgb, var(--color-text) 90%, transparent);
		color: var(--color-surface);
		font-family: var(--font-body);
		font-size: var(--font-size-xs);
		line-height: 1.2;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

</style>
