---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import RecordArchive from "../../components/RecordArchive.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"category",
);
---

<RecordArchive
	title={term.label}
	pageTitle={`分類「${term.label}」`}
	description={`「${term.label}」に分類された記録です。`}
	label="分類"
	note={term.description || `「${term.label}」に分類された記録を、新しい順に掲載しています。`}
	emptyMessage={`「${term.label}」に分類された公開済みの記録はありません。`}
	{posts}
	{categoriesByEntry}
	basePath={`/category/${term.slug}`}
	{cursor}
	{nextCursor}
>
	<a slot="navigation" href="/posts" class="paper-link">記録一覧</a>
</RecordArchive>
