---
import {
	getEmDashEntry,
	getEmDashCollection,
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getSiteSettingsWithCacheHint,
	getRequestContext,
} from "emdash";
import { PortableText, WidgetArea } from "emdash/ui";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import ArticleFigure from "../../components/ArticleFigure.astro";
import ArticleImageBlock from "../../components/ArticleImageBlock.astro";
import PostCard from "../../components/PostCard.astro";
import { formatDate } from "../../utils/locale";
import { formatRecordNumber } from "../../utils/record-number";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const settings = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settings.cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(settings.data);

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl,
});

const bylines = post.data.bylines ?? [];
const writerNames = bylines.map(({ byline, roleLabel }) =>
	roleLabel ? `${byline.displayName}（${roleLabel}）` : byline.displayName,
).join("、");
const interviewer = post.data.interviewer?.trim();
const authorId = "authorId" in post.data && typeof post.data.authorId === "string"
	? post.data.authorId
	: undefined;
const posterByline = bylines.find(({ byline, source }) =>
	authorId ? byline.userId === authorId : source === "inferred",
);
const localDb = Astro.locals.emdash?.db;
// Anonymous rendering exposes the scoped database through the request context.
const db = localDb ?? (getRequestContext()?.db as typeof localDb);
const posterName = posterByline?.byline.displayName.trim() || (
	authorId && db
		? (await db.selectFrom("users").select("name").where("id", "=", authorId).executeTakeFirst())?.name?.trim()
		: undefined
);
const editorialNote = post.data.editorial_note?.trim() || "なし";

// Replace the old sample footer at render time, preserving the stored article.
const legacyCredit = "取材・構成：編集部（サンプル）";
const legacyNote = "注記：本記事は掲載テスト用に制作されたフィクションです。";
const articleContent = [...(post.data.content ?? [])];
for (let index = 0; index < 2; index++) {
	const block = articleContent.at(-1);
	if (block?._type !== "block" || !Array.isArray(block.children)) break;
	const text = block.children.map((child) => child.text ?? "").join("").replace(/\s+/g, "");
	if (text !== legacyCredit && text !== legacyNote && text !== legacyCredit + legacyNote) break;
	articleContent.pop();
}
const interviewee = post.data.interviewee?.trim();
const interviewMethod = post.data.interview_method?.trim();
const rawInterviewDate = post.data.interview_date;
const interviewDate = rawInterviewDate ? new Date(rawInterviewDate) : null;
const interviewDateLabel = interviewDate && Number.isFinite(interviewDate.getTime())
	? formatDate(interviewDate, "long")
	: null;

// This post's tags are already hydrated onto the entry by getEmDashEntry —
// no extra query needed.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];

// Fetch a few extra recent posts in case the current post is among them.
const { entries: recentPosts, cacheHint: recentPostsCacheHint } =
	await getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 4,
	});
if (Astro.cache?.enabled) Astro.cache.set(recentPostsCacheHint);
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: (otherTagsByEntry.get(p.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));

const publishedAt = post.data.publishedAt ?? null;
const publishDate = publishedAt ? formatDate(publishedAt, "long") : null;
const recordNumber = formatRecordNumber(post.data.record_number);

---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="post">
		<header class="band post-header">
			<div class="frame reading-frame post-layout">
				<div class="post-main post-header__inner">
					{(recordNumber || categories.length > 0) && (
						<div class="post-header__identity">
							{recordNumber && <p class="post-header__record-number">{recordNumber}</p>}
							{recordNumber && categories.length > 0 && <span aria-hidden="true">／</span>}
							{categories.length > 0 && (
								<ul class="post-header__categories" aria-label="カテゴリー" role="list">
									{categories.map((term) => (
										<li><a href={`/category/${term.slug}`} class="paper-link">{term.label}</a></li>
									))}
								</ul>
							)}
						</div>
					)}
					{post.data.excerpt && (
						<div class="post-header__preface">
							<p class="post-header__preface-label">はじめに</p>
							<p class="reading-lead post-header__lead" {...post.edit.excerpt}>{post.data.excerpt}</p>
						</div>
					)}
					{(interviewer || writerNames || posterName || interviewee || interviewDateLabel || interviewMethod || publishedAt || categories.length > 0) && (
						<dl class="post-header__credits" aria-label="取材情報">
							{interviewer && (
								<div class="post-header__credit">
									<dt>取材者</dt>
									<dd>{interviewer}</dd>
								</div>
							)}
							{writerNames && (
								<div class="post-header__credit">
									<dt>執筆者</dt>
									<dd>{writerNames}</dd>
								</div>
							)}
							{posterName && (
								<div class="post-header__credit">
									<dt>投稿者</dt>
									<dd>{posterName}</dd>
								</div>
							)}
							{interviewee && (
								<div class="post-header__credit">
									<dt>取材対象者</dt>
									<dd>{interviewee}</dd>
								</div>
							)}
							{interviewDateLabel && interviewDate && (
								<div class="post-header__credit">
									<dt>取材日</dt>
									<dd><time datetime={interviewDate.toISOString()}>{interviewDateLabel}</time></dd>
								</div>
							)}
							{interviewMethod && (
								<div class="post-header__credit">
									<dt>取材方法</dt>
									<dd>{interviewMethod}</dd>
								</div>
							)}
							{publishedAt && (
								<div class="post-header__credit">
									<dt>公開日</dt>
									<dd><time datetime={publishedAt.toISOString()}>{publishDate}</time></dd>
								</div>
							)}
							{categories.length > 0 && (
								<div class="post-header__credit">
									<dt>テーマ</dt>
									<dd>
										<ul class="post-header__categories" role="list">
											{categories.map((term) => (
												<li><a href={`/category/${term.slug}`} class="paper-link">{term.label}</a></li>
											))}
										</ul>
									</dd>
								</div>
							)}
						</dl>
					)}
					{post.data.featured_image && (
						<div class="post-header__figure" {...post.edit.featured_image}>
							<ArticleFigure image={post.data.featured_image} />
						</div>
					)}
					<div class="post-header__title-block">
						{recordNumber && <p class="post-header__record-number">{recordNumber}</p>}
						<h1 class="reading-title post-header__title" {...post.edit.title}>{post.data.title}</h1>
					</div>
				</div>
			</div>
		</header>

		<div class="band post-body">
			<div class="frame reading-frame post-layout">
				<div class="post-main">
					<details class="toc toc--inline" data-toc hidden>
						<summary>目次</summary>
						<ol class="toc__list" data-toc-list role="list"></ol>
					</details>
					<div class="prose" data-post-content>
						<PortableText value={articleContent} components={{ type: { image: ArticleImageBlock } }} />
					</div>
					<dl class="post-header__credits post-colophon">
						<div class="post-header__credit">
							<dt>構成</dt>
							<dd>大和自治会広報部{posterName && `（${posterName}）`}</dd>
						</div>
						<div class="post-header__credit">
							<dt>注記</dt>
							<dd>{editorialNote}</dd>
						</div>
					</dl>

					{tags.length > 0 && (
						<ul class="chips post-topics" aria-label="タグ" role="list">
							{tags.map((term) => (
								<li><a href={`/tag/${term.slug}`} class="chip">{term.label}</a></li>
							))}
						</ul>
					)}

					<section class="post-comments" aria-labelledby="comments-title">
						<h2 id="comments-title" class="eyebrow">コメント</h2>
						<Comments collection="posts" contentId={post.data.id} threaded locale="ja-JP" labels={{
							heading: (count) => count ? `コメント ${count}件` : "コメントはまだありません",
							member: "サイトメンバー",
						}} />
						<CommentForm collection="posts" contentId={post.data.id} labels={{
							name: "お名前",
							email: "メールアドレス",
							comment: "コメント本文",
							submit: "コメントを送る",
							submitting: "送信中…",
							published: "コメントを公開しました。",
							pending: "コメントを受け付けました。確認後に公開します。",
							error: "コメントを送れませんでした。入力内容をご確認ください。",
							networkError: "通信に失敗しました。時間をおいて再度お試しください。",
						}} />
					</section>
					<a href="/posts" class="paper-link post-back-link">記録一覧へ戻る</a>
				</div>

				<div class="post-rail">
					<aside class="post-widgets" aria-labelledby="widgets-title">
						<h2 id="widgets-title" class="sr-only">記録を探す</h2>
						<WidgetArea name="sidebar" />
					</aside>
				</div>
			</div>
		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="band section" aria-labelledby="continue-reading">
				<div class="frame related">
					<div class="section-head">
						<h2 id="continue-reading" class="section-head__title">次に読む記録</h2>
						<a href="/posts" class="arrow-link">
							記録一覧
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="post-grid">
						{otherPostsWithTags.map(({ post: p, tags: postTags }) => (
							<PostCard
								post={p}
								tags={postTags}
								variant="card"
								headingLevel={3}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<script>
		for (const figure of document.querySelectorAll<HTMLElement>(
			".post-header__figure figure.article-figure, [data-post-content] figure:is(.emdash-image, .emdash-gallery-item)",
		)) {
			const photo = figure.querySelector<HTMLImageElement>("img:not(.emdash-image--dark)");
			const showFallback = () => {
				if (figure.classList.contains("article-photo-unavailable")) return;
				figure.classList.add("article-photo-unavailable");

				const frame = document.createElement("div");
				frame.className = "article-photo-fallback";
				const message = document.createElement("span");
				message.textContent = "イメージを読み込めませんでした";
				frame.append(message);

				const alt = (photo?.alt ?? figure.dataset.photoAlt)?.trim();
				if (alt) {
					const description = document.createElement("span");
					description.textContent = alt;
					frame.append(description);
				}

				if (photo) photo.replaceWith(frame);
				else figure.prepend(frame);
			};

			const showPhoto = () => figure.classList.add("article-photo-ready");
			if (!photo) {
				showFallback();
			} else if (photo.complete) {
				if (photo.naturalWidth > 0) showPhoto();
				else showFallback();
			} else {
				photo.addEventListener("load", showPhoto, { once: true });
				photo.addEventListener("error", showFallback, { once: true });
			}
		}

		// Build the table of contents from the body's h2/h3 headings
		function buildToc() {
			const content = document.querySelector("[data-post-content]");
			const toc = document.querySelector<HTMLElement>("[data-toc]");
			const list = toc?.querySelector("[data-toc-list]");
			if (!content || !toc || !list) return;

			for (const paragraph of content.querySelectorAll("p:has(> strong:only-child)")) {
				const text = paragraph.textContent?.trim();
				const emphasis = paragraph.firstElementChild?.textContent?.trim();
				if (text === emphasis && /[？?][」』）)]?$/.test(text ?? "")) {
					paragraph.classList.add("interview-question");
				}
			}

			const headings = [
				...content.querySelectorAll<HTMLHeadingElement>("h2, h3"),
			];
			if (headings.length === 0) return;

			const tocHeadings = new Set<Element>(headings);
			const usedIds = new Set(
				Array.from(document.querySelectorAll("[id]"))
					.filter((element) => !tocHeadings.has(element))
					.map((element) => element.id),
			);
			const links = new Map<Element, HTMLAnchorElement>();
			let chapter: HTMLLIElement | undefined;
			let subsections: HTMLOListElement | undefined;
			headings.forEach((heading, index) => {
				const baseId = heading.id || `heading-${index}`;
				let id = baseId;
				for (let suffix = 2; usedIds.has(id); suffix++) {
					id = `${baseId}-${suffix}`;
				}
				usedIds.add(id);
				heading.id = id;
				heading.tabIndex = -1;

				const item = document.createElement("li");
				if (heading.tagName === "H2") {
					chapter = item;
					subsections = undefined;
				}

				const link = document.createElement("a");
				link.href = `#${encodeURIComponent(id)}`;
				link.className = "toc__link";
				link.textContent = heading.textContent;

				item.appendChild(link);
				if (heading.tagName === "H3" && chapter) {
					if (!subsections) {
						subsections = document.createElement("ol");
						subsections.className = "toc__subsections";
						chapter.appendChild(subsections);
					}
					subsections.appendChild(item);
				} else {
					list.appendChild(item);
				}
				links.set(heading, link);
			});
			toc.hidden = false;
			if (location.hash) {
				try {
					const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
					if (target && links.has(target)) target.scrollIntoView();
				} catch {
					// A malformed fragment has no matching heading.
				}
			}

			// Mark the section currently in view
			const setCurrent = (link: HTMLAnchorElement) => {
				for (const other of links.values()) {
					other.removeAttribute("aria-current");
				}
				link.setAttribute("aria-current", "true");
			};
			const first = links.values().next().value;
			if (first) setCurrent(first);

			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						const link = links.get(entry.target);
						if (link && entry.isIntersecting) setCurrent(link);
					}
				},
				{ rootMargin: "-80px 0px -80% 0px" },
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		buildToc();
	</script>
</Base>

<style>
	.post {
		--article-photo-space: clamp(1.75rem, 4vw, 3rem);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.post-header {
		padding-block: clamp(2rem, 1.25rem + 3vw, 4rem) 0;
	}

	.post-header__inner {
		text-align: start;
	}

	.post-header__identity {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--spacing-1) var(--spacing-4);
		margin-block-end: var(--spacing-3);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		overflow-wrap: anywhere;
	}

	.post-header__record-number {
		font-family: var(--font-heading);
	}

	.post-header__preface {
		margin-block-start: var(--spacing-6);
	}

	.post-header__preface-label,
	.post-header__title-block .post-header__record-number {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.post-header__lead {
		margin-block-start: var(--spacing-2);
		font-family: var(--font-reading);
		font-size: clamp(1.125rem, 1.06rem + 0.3vw, 1.3125rem);
		line-height: 1.85;
		line-break: strict;
		color: var(--color-text-secondary);
		overflow-wrap: break-word;
		white-space: pre-line;
	}

	.post-header__title-block {
		margin-block-start: var(--article-photo-space);
		text-align: center;
	}

	.post-header__title-block .post-header__record-number {
		margin-block-end: var(--spacing-2);
	}

	.post-header__title {
		font-family: var(--font-heading);
		font-size: clamp(1.625rem, 1.25rem + 1.5vw, 2.5rem);
		line-height: 1.45;
		line-break: strict;
		overflow-wrap: break-word;
	}

	.post-header__credits {
		display: grid;
		gap: var(--spacing-1);
		max-inline-size: 34rem;
		margin-block-start: var(--spacing-6);
		padding-block: var(--spacing-3);
		border-block: 1px solid var(--color-border);
	}

	.post-header__credit {
		display: grid;
		grid-template-columns: 6em minmax(0, 1fr);
		align-items: baseline;
		gap: var(--spacing-2);
		font-size: var(--font-size-sm);
		overflow-wrap: anywhere;
	}

	.post-header__credit dt {
		color: var(--color-muted);
	}

	.post-header__credit dd {
		margin: 0;
	}

	.post-colophon {
		margin-block-start: var(--spacing-8);
	}

	.post-colophon dd {
		white-space: pre-line;
	}

	.post-header__categories {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-1) var(--spacing-3);
		list-style: none;
	}

	.post-body {
		padding-block: var(--spacing-6) clamp(3rem, 6vw, 5rem);
	}

	.post-back-link {
		display: inline-block;
		margin-block-start: var(--spacing-8);
	}

	.prose[data-post-content] {
		line-height: 1.95;
	}

	.prose[data-post-content] > :global(:is(h2, h3, h4, h5, h6)) {
		margin-block-start: 2em;
		scroll-margin-block-start: 5rem;
		break-after: avoid;
	}

	.prose[data-post-content] > :global(:is(h2, h3, h4, h5, h6) + *) {
		margin-block-start: 0.65em;
	}

	.prose[data-post-content] > :global(.interview-question) {
		margin-block-start: 1.85em;
	}

	.prose[data-post-content] > :global(.interview-question + p) {
		margin-block-start: 0.6em;
	}

	.post-header__figure :global(figure.article-figure),
	.prose[data-post-content] :global(figure.emdash-image) {
		float: none;
		inline-size: fit-content;
		max-inline-size: 100%;
		margin: var(--article-photo-space) auto;
	}

	.post-header__figure :global(figure.article-figure) {
		margin-block-start: var(--spacing-3);
	}

	.prose[data-post-content] :global(.emdash-gallery) {
		margin-block: var(--article-photo-space);
		align-items: start;
	}

	.post-header__figure :global(figure.article-figure img),
	.prose[data-post-content] :global(figure:is(.emdash-image, .emdash-gallery-item) img) {
		display: block;
		inline-size: auto;
		max-inline-size: 100%;
		block-size: auto;
		aspect-ratio: auto;
		object-fit: contain;
		margin-inline: auto;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.post-header__figure :global(figure.article-figure > figcaption),
	.prose[data-post-content] :global(figure:is(.emdash-image, .emdash-gallery-item) > figcaption) {
		contain: inline-size;
		margin-block-start: var(--spacing-2);
		color: var(--color-muted);
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		line-height: 1.65;
		text-align: start;
		line-break: strict;
		overflow-wrap: anywhere;
		white-space: pre-line;
	}

	@media (scripting: enabled) {
		.post-header__figure :global(figure.article-figure:not(.article-photo-ready, .article-photo-unavailable) :is(img, figcaption)),
		.prose[data-post-content] :global(figure:is(.emdash-image, .emdash-gallery-item):not(.article-photo-ready, .article-photo-unavailable) :is(img, figcaption)) {
			visibility: hidden;
		}
	}

