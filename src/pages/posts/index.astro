---
import {
	getEmDashCollection,
	getTaxonomyTermsWithCacheHint,
	getTermsForEntries,
} from "emdash";
import RecordArchive from "../../components/RecordArchive.astro";
import { flattenTerms } from "../../utils/taxonomy";

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const entryIds = posts.map((post) => post.data.id);
const [categoriesByEntry, categoryResult] = await Promise.all([
	getTermsForEntries("posts", entryIds, "category"),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: false }),
]);
if (Astro.cache?.enabled) Astro.cache.set(categoryResult.cacheHint);
---

<RecordArchive
	title="記録一覧"
	description="大和地区の記録を公開日順に掲載しています。"
	readingLayout
	emptyMessage="公開された記録は、こちらに掲載します。"
	{posts}
	{categoriesByEntry}
	basePath="/posts"
	{cursor}
	{nextCursor}
>
	{categoryResult.data.length > 0 && (
		<nav slot="navigation" class="archive-categories" aria-labelledby="archive-categories-title">
			<p class="archive-categories__label">記録の索引</p>
			<h2 id="archive-categories-title">テーマからたどる</h2>
			<ul role="list">
				{flattenTerms(categoryResult.data).map((term) => (
					<li>
						<h3><a href={`/category/${term.slug}`} class="paper-link">{term.label}</a></h3>
						{term.description?.trim() && <p class="paper-reading">{term.description}</p>}
					</li>
				))}
			</ul>
		</nav>
	)}
</RecordArchive>

<style>
	.archive-categories__label {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		letter-spacing: 0.12em;
	}

	.archive-categories h2 {
		margin-block-start: var(--spacing-1);
		font-size: var(--font-size-2xl);
	}

	.archive-categories ul {
		display: grid;
		gap: var(--spacing-5);
		margin-block-start: var(--spacing-4);
		list-style: none;
	}

	.archive-categories li :is(h3, p) {
		font-size: 1.0625rem;
	}

	.archive-categories li p {
		margin-block-start: var(--spacing-1);
		color: var(--color-text-secondary);
		overflow-wrap: anywhere;
		white-space: pre-line;
	}

	@media (max-width: 720px) {
		.archive-categories__label {
			font-size: var(--font-size-xs);
		}

		.archive-categories h2 {
			font-size: var(--font-size-xl);
		}
	}
</style>
