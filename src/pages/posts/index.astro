---
import {
	getEmDashCollection,
	getTaxonomyTermsWithCacheHint,
	getTermsForEntries,
} from "emdash";
import RecordArchive from "../../components/RecordArchive.astro";

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const entryIds = posts.map((post) => post.data.id);
const [categoriesByEntry, categoryResult] = await Promise.all([
	getTermsForEntries("posts", entryIds, "category"),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: false }),
]);
if (Astro.cache?.enabled) Astro.cache.set(categoryResult.cacheHint);
---

<RecordArchive
	title="記録一覧"
	description="大和地区の記録を公開日順に掲載しています。"
	label="大和地区"
	note="開発のころの記憶から、今日の暮らしまで。大和地区の記録を公開日の新しい順に並べています。"
	emptyMessage="公開された記録は、こちらに掲載します。"
	{posts}
	{categoriesByEntry}
	basePath="/posts"
	{cursor}
	{nextCursor}
>
	{categoryResult.data.length > 0 && (
		<nav slot="navigation" class="archive-categories" aria-label="分類から探す">
			<p>分類から探す</p>
			<ul role="list">
				{categoryResult.data.map((term) => (
					<li><a href={`/category/${term.slug}`} class="paper-link">{term.label}</a></li>
				))}
			</ul>
		</nav>
	)}
</RecordArchive>

<style>
	.archive-categories {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--spacing-1) var(--spacing-6);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.archive-categories ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2) var(--spacing-4);
		list-style: none;
	}

	.archive-categories a {
		display: inline-block;
		padding-block: var(--spacing-1);
	}
</style>
