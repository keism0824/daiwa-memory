---
import {
	getEmDashCollection,
	getSiteSettingsWithCacheHint,
	getTermsForEntries,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 5,
	}),
	getSiteSettingsWithCacheHint(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings.data);
const introduction =
	"この街が生まれたころのこと。ここで営まれてきた暮らしのこと。人々へのインタビューと、残された資料や写真から、一人ひとりの歩みを記録します。";

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(settings.cacheHint);
}

const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"category",
);
---

<Base title={siteTitle} description={`兵庫県川西市大和地区（旧阪急北ネオポリス）。${introduction}`}>
	<header class="band">
		<div class="frame">
			<div class="paper-sheet home-intro">
				<p class="home-intro__place">
					兵庫県川西市 大和地区
					<span>旧阪急北ネオポリス</span>
				</p>
				<h1 class="intro__title home-intro__title">{siteTitle}</h1>
				{siteTagline && <p class="paper-reading home-intro__tagline">{siteTagline}</p>}
				<p class="paper-reading home-intro__note">{introduction}</p>
				<a class="paper-link" href="/pages/about">この記録集について</a>
			</div>
		</div>
	</header>

	<section class="band home-section" aria-labelledby="latest-posts">
		<div class="frame">
			<div class="paper-sheet home-section__sheet">
				<h2 id="latest-posts" class="record-list-title home-contents__heading">記録</h2>
				{posts.length > 0 ? (
					<ol class="archive-list" role="list">
						{posts.map((post) => (
							<li>
								<PostCard
									post={post}
									categories={categoriesByEntry.get(post.data.id)}
									variant="contents"
									headingLevel={3}
								/>
							</li>
						))}
					</ol>
				) : (
					<p class="paper-reading home-contents__empty">公開された記録は、こちらに掲載します。</p>
				)}
				<a class="paper-link home-contents__link" href="/posts">記録一覧を見る</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.home-intro {
		padding-block: clamp(3.75rem, 10vw, 8rem) clamp(2.25rem, 5vw, 3.75rem);
	}

	.home-intro__place {
		margin-block-end: clamp(1.5rem, 4vw, 3rem);
		font-size: var(--font-size-sm);
		letter-spacing: 0.11em;
		line-height: 1.8;
		color: var(--color-muted);
	}

	.home-intro__place span {
		display: block;
	}

	.home-intro__title {
		font-size: clamp(1.6875rem, 1.0125rem + 2.7vw, 3.1875rem);
		letter-spacing: 0.035em;
		line-height: 1.28;
	}

	.home-intro__tagline {
		margin-block-start: var(--spacing-4);
		font-size: clamp(1.125rem, 0.9rem + 0.5vw, 1.375rem);
	}

	.home-intro__note {
		margin-block: clamp(1.75rem, 4vw, 2.75rem) var(--spacing-4);
		color: var(--color-text-secondary);
	}

	.home-section {
		padding-block-end: clamp(4rem, 8vw, 7rem);
	}

	.home-section__sheet {
		border-block-start: 1px solid var(--color-border);
		padding-block-start: clamp(1.75rem, 4vw, 2.75rem);
	}

	.home-contents__heading {
		margin-block-end: clamp(2rem, 1.75rem + 1vw, 2.5rem);
	}

	.home-contents__empty {
		color: var(--color-muted);
	}

	.home-contents__link {
		display: inline-block;
		margin-block-start: var(--spacing-8);
	}
</style>
