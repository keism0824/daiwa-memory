---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettingsWithCacheHint,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";
import "../../styles/reading-page.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const settings = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(settings.cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(settings.data);
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="band reading-page">
		<div class="frame reading-frame reading-page__layout">
			<header class="reading-page__header">
				<h1 class="record-list-title reading-title reading-page__title" {...page.edit.title}>{page.data.title}</h1>
			</header>

			<div class="prose page__body" {...page.edit.content}>
				<PortableText value={page.data.content} />
			</div>
		</div>
	</article>
</Base>
