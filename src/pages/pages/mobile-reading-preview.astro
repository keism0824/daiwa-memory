---
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import "../../styles/prose.css";
const paragraph = { _type: "block", style: "normal", markDefs: [],
	children: [{ _type: "span", text: "街が生まれたころの記憶を、人々へのインタビューと写真を通して記録します。".repeat(3), marks: [] }],
};
const page = { edit: {}, data: { id: "shared-reading-check", title: "この記録集について",
	content: [
		{ ...paragraph, _key: "title", style: "h2" },
		{ ...paragraph, _key: "first" },
		{ ...paragraph, _key: "second" },
		{ ...paragraph, _key: "center", textAlign: "center" },
	],
} };
const seo = { title: page.data.title };
const slug = "mobile-reading-preview";
---
<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="band page">
		<div class="frame reading-frame page__layout">
			<header class="page__header">
				<h1 class="record-list-title reading-title page__title" {...page.edit.title}>{page.data.title}</h1>
			</header>

			<div class="prose page__body" {...page.edit.content}>
				<PortableText value={page.data.content} />
			</div>
		</div>
	</article>
</Base>

<style>
	.page {
		padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(4rem, 3rem + 4vw, 7rem);
	}

	.page__layout {
		display: grid;
		grid-template-columns: minmax(0, var(--content-width));
		justify-content: center;
		gap: var(--spacing-5);
	}

	@media (min-width: 960px) {
		.page {
			--content-width: var(--desktop-reading-width);
		}

		.page__layout {
			grid-template-columns: auto minmax(0, var(--content-width));
			column-gap: clamp(1.375rem, 2.3vw, 2.25rem);
		}

		.page__header {
			position: sticky;
			inset-block-start: calc(var(--nav-height) + var(--spacing-4));
			align-self: start;
		}

		.page__title {
			font-size: 1.75rem;
			writing-mode: vertical-rl;
			max-inline-size: calc(100dvh - var(--nav-height) - var(--spacing-8));
			text-wrap: wrap;
		}
	}
</style>
